<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_large_background"
    android:clipToOutline="true"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/widget_cover_round_background"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_player_cover_art"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="18dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:weightSum="1"
            android:layout_weight="1">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/player_no_playback"
                android:textColor="#263331"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#7A7773"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_previous"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/player_previous"
                    android:padding="8dp"
                    android:scaleType="center"
                    android:src="@drawable/widget_skip_previous_dark_24" />

                <ImageButton
                    android:id="@+id/widget_play_pause"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/player_play"
                    android:padding="6dp"
                    android:scaleType="center"
                    android:src="@drawable/widget_play_arrow_dark_24" />

                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/player_next"
                    android:padding="8dp"
                    android:scaleType="center"
                    android:src="@drawable/widget_skip_next_dark_24" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
